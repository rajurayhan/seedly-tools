# =============================================================================
# seedly-crm — Coolify / VPS environment
# =============================================================================
# Paste these into the Coolify resource env editor. Do not commit real values.
# Generate secrets once (openssl rand -hex 32 or openssl rand -base64 32).
# Never rotate INSTANCE_SECRET after Convex has written data — that orphans
# the convex-data volume.
#
# Public URLs: use the exact HTTPS FQDNs Coolify assigns (Generate Domain /
# sslip.io is fine until real product domains exist). Rebuild the web image
# after any NEXT_PUBLIC_* change. Do not attach apps to your Coolify hostname.
#
# Do not set CONVEX_DEPLOYMENT — that binds Convex Cloud and fights this stack.

# ---------------------------------------------------------------------------
# Convex self-hosted instance
# ---------------------------------------------------------------------------
INSTANCE_NAME=seedly-crm-staging
INSTANCE_SECRET=CHANGE_ME
# Pin to a released tag in Coolify. `latest` will drift.
CONVEX_BACKEND_TAG=latest
DISABLE_BEACON=true

# Public HTTPS origins (browser + Convex). Replace with Coolify FQDNs.
CONVEX_CLOUD_ORIGIN=https://REPLACE_ME
CONVEX_SITE_ORIGIN=https://REPLACE_ME
NEXT_PUBLIC_DEPLOYMENT_URL=https://REPLACE_ME
NEXT_PUBLIC_CONVEX_URL=https://REPLACE_ME
NEXT_PUBLIC_CONVEX_SITE_URL=https://REPLACE_ME

# CLI → backend (compose DNS). Leave these on the service names.
CONVEX_SELF_HOSTED_URL=http://convex-backend:3210
CONVEX_URL=http://convex-backend:3210
CONVEX_SITE_URL=http://convex-backend:3211

# ---------------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------------
# SITE_URL / FRONTEND_URL / NEXT_PUBLIC_APP_URL = the public HTTPS web FQDN.
# INTERNAL_APP_URL stays on compose DNS so Convex PDF actions reach Next.js.
SITE_URL=https://REPLACE_ME
FRONTEND_URL=https://REPLACE_ME
NEXT_PUBLIC_APP_URL=https://REPLACE_ME
INTERNAL_APP_URL=http://web:3000

# ---------------------------------------------------------------------------
# Secrets — generate once, keep stable
# ---------------------------------------------------------------------------
# INSTANCE_SECRET / ENCRYPTION_KEY / INTERNAL_API_SECRET: openssl rand -hex 32
# BETTER_AUTH_SECRET / UNSUBSCRIBE_SECRET / PREFERENCES_SECRET: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME
BETTER_AUTH_SECRET=CHANGE_ME
UNSUBSCRIBE_SECRET=CHANGE_ME
PREFERENCES_SECRET=CHANGE_ME
INTERNAL_API_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# Optional branding / analytics
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=CRM System
NEXT_PUBLIC_FAVICON=/favicon-default.svg
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
