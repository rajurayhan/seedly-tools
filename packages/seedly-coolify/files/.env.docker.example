# =============================================================================
# seedly-crm — Docker Compose environment
# =============================================================================
# Copied to .env.docker by `make docker-env`. Secrets are filled automatically
# when empty. Do not commit .env.docker.
#
# This file is mounted over .env.local *inside containers only* so a host
# Convex Cloud binding (CONVEX_DEPLOYMENT=dev:...) cannot leak into Docker.

# ---------------------------------------------------------------------------
# Convex self-hosted instance
# ---------------------------------------------------------------------------
INSTANCE_NAME=seedly-crm-dev
INSTANCE_SECRET=CHANGE_ME
CONVEX_BACKEND_TAG=latest
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210
DISABLE_BEACON=true

# Browser-facing Convex URLs (published on the host)
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# CLI → backend (container DNS). Do not set CONVEX_DEPLOYMENT here.
CONVEX_SELF_HOSTED_URL=http://convex-backend:3210

# ---------------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------------
# SITE_URL / FRONTEND_URL stay on localhost so Better Auth accepts the browser.
# INTERNAL_APP_URL is container-to-container (Convex PDF actions → Next.js).
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_APP_URL=http://web:3000
WEB_PORT=3000
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_DASHBOARD_PORT=6791

# ---------------------------------------------------------------------------
# Secrets — generated by make docker-env when empty / CHANGE_ME
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=CHANGE_ME
BETTER_AUTH_SECRET=CHANGE_ME
UNSUBSCRIBE_SECRET=CHANGE_ME
PREFERENCES_SECRET=CHANGE_ME
INTERNAL_API_SECRET=CHANGE_ME

# ---------------------------------------------------------------------------
# Docker seed — demo Better Auth logins (owner@acme.dev and friends)
# ---------------------------------------------------------------------------
SEED_OWNER_PASSWORD=test-password-owner

# ---------------------------------------------------------------------------
# Optional branding / analytics (same names as .env.example)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=CRM System
NEXT_PUBLIC_FAVICON=/favicon-default.svg
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
