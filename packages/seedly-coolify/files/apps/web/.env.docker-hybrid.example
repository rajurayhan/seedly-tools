# Copy to apps/web/.env.local for hybrid: Next.js on the Mac, Convex in Docker.
#   cp apps/web/.env.docker-hybrid.example apps/web/.env.local
#
# Do not set CONVEX_DEPLOYMENT — that binds Convex Cloud and fights this stack.

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3310
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3311
CONVEX_URL=http://127.0.0.1:3310
CONVEX_SITE_URL=http://127.0.0.1:3311
# Auth proxy Host header — container listen port, not the published 3311.
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_APP_URL=http://localhost:3100
SITE_URL=http://localhost:3100
